_build/
target/
target
dist/
.mooncakes/
.moonagent/
.moonsuite/

# Controlled ERP migration artifacts. Keep exports and raw staging outside the
# repository when possible; ignore them if a local rehearsal uses this tree.
erp-export/
erp-staging*.ndjson
erp-staging*.json
company*.sqlite3*
typed-cohorts/
__pycache__/
erp-promotion-plan*.json
erp-workflow-plan*.json
erp-lifecycle-plan*.json
erp-task-plan*.json
erp-investment-plan*.json
erp-payment-plan*.json
erp-user-plan*.json
erp-audit-plan*.json
erp-parameter-plan*.json
erp-task-state-plan*.json
domain-promotion*.json
projection-apply*.json
projection-parity*.json

# MoonClaw writes completed audit envelopes here. Only the contract/readme and
# directory placeholders are versioned; evidence is ingested into PostgreSQL.
engineering/evidence/inbox/*.json
engineering/evidence/archive/*.json
!engineering/evidence/inbox/.gitkeep
!engineering/evidence/archive/.gitkeep
