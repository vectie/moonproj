{
  "jobs": {
    "profiles": {
      "moonsuite-engineering-controller": {
        "family": "moonsuite_engineering_controller",
        "role": "controller",
        "priority": 190,
        "tags": ["moonsuite", "engineering", "evidence", "release"],
        "match": {
          "all": ["moonsuite"],
          "any": ["engineering", "audit", "progress", "health", "production", "quality", "release"]
        },
        "steps": [
          {
            "id": "collect_unified_evidence",
            "title": "Test the exact candidate through G1-G9",
            "kind": "job.delegate",
            "request_template": "Inspect ${proposal.title} at its exact candidate identity and produce one moonsuite.engineering-evidence.v2 ledger containing R1-R3 and G1-G9. Use the same receipts for progress, health, production quality, and release rehearsal. Do not edit or publish the repository.",
            "child_profile": "moonsuite-production-worker",
            "include_parent_outputs": false,
            "max_depth": 2,
            "metadata": {"board_lane": "Evidence ledger", "board_order": 0}
          },
          {
            "id": "independent_review",
            "title": "Independently review evidence",
            "kind": "job.delegate",
            "request_template": "Independently review the single G1-G9 evidence ledger for ${proposal.title}. Verify candidate identity and producer/reviewer separation, rerun a risk-weighted sample, and reject unsupported receipts.",
            "child_profile": "moonsuite-evidence-reviewer",
            "include_parent_outputs": true,
            "max_depth": 2,
            "metadata": {"board_lane": "Independent review", "board_order": 1}
          },
          {
            "id": "project_moonproj_view",
            "title": "Prepare MoonProj projection",
            "kind": "job.analysis",
            "prompt_template": "Return the independently reviewed moonsuite.engineering-evidence.v2 ledger for ${proposal.title}. MoonProj derives progress, health, and production projections; do not add scores or publication authority.",
            "metadata": {
              "preferred_skills": ["moonsuite-evidence-review"],
              "enable_tools": false,
              "board_lane": "MoonProj", "board_order": 2,
              "role_runtime": {
                "planning_layer": "domain",
                "runtime_mode": "planner_only",
                "tool_access": "none",
                "memory_scope": "domain",
                "allow_delegate": false,
                "allow_workspace_write": false,
                "allow_execution_tools": false,
                "output_contract": "moonsuite.engineering-evidence.v2"
              }
            }
          }
        ]
      },
      "moonsuite-progress-worker": {
        "family": "moonsuite_progress_worker",
        "priority": 20,
        "tags": ["moonsuite", "engineering", "progress", "worker"],
        "steps": [{
          "id": "audit_progress",
          "title": "Audit lifecycle progress",
          "kind": "job.analysis",
          "prompt_template": "Use the MoonSuite progress audit skill for ${request}.",
          "metadata": {
            "preferred_skills": ["moonsuite-progress-audit"], "enable_tools": true,
            "role_runtime": {"planning_layer": "execution", "runtime_mode": "executor", "tool_access": "full", "memory_scope": "workspace", "allow_delegate": false, "allow_workspace_write": false, "allow_execution_tools": true, "output_contract": "moonsuite.project-progress-evidence.v1"}
          }
        }]
      },
      "moonsuite-health-worker": {
        "family": "moonsuite_health_worker",
        "priority": 20,
        "tags": ["moonsuite", "engineering", "health", "worker"],
        "steps": [{
          "id": "audit_health",
          "title": "Run engineering health checks",
          "kind": "job.analysis",
          "prompt_template": "Use the MoonSuite health audit skill for ${request}.",
          "metadata": {
            "preferred_skills": ["moonsuite-health-audit"], "enable_tools": true,
            "role_runtime": {"planning_layer": "execution", "runtime_mode": "executor", "tool_access": "full", "memory_scope": "workspace", "allow_delegate": false, "allow_workspace_write": false, "allow_execution_tools": true, "output_contract": "moonsuite.project-health-evidence.v1"}
          }
        }]
      },
      "moonsuite-production-worker": {
        "family": "moonsuite_production_worker",
        "priority": 20,
        "tags": ["moonsuite", "engineering", "production", "worker"],
        "steps": [{
          "id": "audit_production",
          "title": "Collect unified G1-G9 evidence",
          "kind": "job.analysis",
          "prompt_template": "Use the MoonSuite production Gate skill for ${request}. Produce one candidate-bound ledger; do not emit separate progress, health, or production artifacts.",
          "metadata": {
            "preferred_skills": ["moonsuite-production-gate"], "enable_tools": true,
            "role_runtime": {"planning_layer": "execution", "runtime_mode": "executor", "tool_access": "full", "memory_scope": "workspace", "allow_delegate": false, "allow_workspace_write": false, "allow_execution_tools": true, "output_contract": "moonsuite.engineering-evidence.v2"}
          }
        }]
      },
      "moonsuite-evidence-reviewer": {
        "family": "moonsuite_evidence_reviewer",
        "priority": 20,
        "tags": ["moonsuite", "engineering", "review", "worker"],
        "steps": [{
          "id": "review_evidence",
          "title": "Review audit evidence",
          "kind": "job.analysis",
          "prompt_template": "Use the MoonSuite evidence review skill for ${request}. You must be a different Agent identity from every evidence producer.",
          "metadata": {
            "preferred_skills": ["moonsuite-evidence-review"], "enable_tools": true,
            "role_runtime": {"planning_layer": "execution", "runtime_mode": "executor", "tool_access": "full", "memory_scope": "workspace", "allow_delegate": false, "allow_workspace_write": false, "allow_execution_tools": true, "output_contract": "moonsuite.evidence-review.v1"}
          }
        }]
      }
    }
  }
}
