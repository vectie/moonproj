{
  "jobs": {
    "profiles": {
      "moonsuite-engineering-controller": {
        "family": "moonsuite_engineering_controller",
        "role": "controller",
        "priority": 190,
        "tags": ["moonsuite", "engineering", "progress", "health", "production"],
        "match": {
          "all": ["moonsuite"],
          "any": ["engineering", "audit", "progress", "health", "production", "quality", "release"]
        },
        "steps": [
          {
            "id": "observe_progress",
            "title": "Observe project progress",
            "kind": "job.delegate",
            "request_template": "Determine how far ${proposal.title} has progressed. Inspect the configured repository at its exact commit and return only the progress evidence contract. Do not edit the repository or infer a percentage without declared milestones.",
            "child_profile": "moonsuite-progress-worker",
            "include_parent_outputs": false,
            "max_depth": 2,
            "metadata": {"board_lane": "Progress", "board_order": 0}
          },
          {
            "id": "measure_health",
            "title": "Measure project health",
            "kind": "job.delegate",
            "request_template": "Measure how well ${proposal.title} is going. Run the repository-declared bounded checks and return only reproducible health evidence. Preserve failures and unknowns.",
            "child_profile": "moonsuite-health-worker",
            "include_parent_outputs": false,
            "max_depth": 2,
            "metadata": {"board_lane": "Health", "board_order": 1}
          },
          {
            "id": "evaluate_production",
            "title": "Evaluate production quality",
            "kind": "job.delegate",
            "request_template": "Evaluate whether ${proposal.title} meets the configured production Gates and redlines at the exact candidate commit or digest. Return criterion evidence, never an invented score or release approval.",
            "child_profile": "moonsuite-production-worker",
            "include_parent_outputs": true,
            "max_depth": 2,
            "metadata": {"board_lane": "Production", "board_order": 2}
          },
          {
            "id": "independent_review",
            "title": "Independently review evidence",
            "kind": "job.delegate",
            "request_template": "Independently review all progress, health, and production artifacts for ${proposal.title}. Verify producer/reviewer separation, rerun a risk-weighted sample, and reject unsupported claims.",
            "child_profile": "moonsuite-evidence-reviewer",
            "include_parent_outputs": true,
            "max_depth": 2,
            "metadata": {"board_lane": "Independent review", "board_order": 3}
          },
          {
            "id": "project_moonproj_view",
            "title": "Prepare MoonProj projection",
            "kind": "job.analysis",
            "prompt_template": "Project only independently accepted claims for ${proposal.title} into three sections: how far it has progressed, how well it is going, and whether it meets production quality. Keep unknowns visible. Return schema moonsuite.engineering-projection.v1 and do not add new ratings.",
            "metadata": {
              "preferred_skills": ["moonsuite-evidence-review"],
              "enable_tools": false,
              "board_lane": "MoonProj", "board_order": 4,
              "role_runtime": {
                "planning_layer": "domain",
                "runtime_mode": "planner_only",
                "tool_access": "none",
                "memory_scope": "domain",
                "allow_delegate": false,
                "allow_workspace_write": false,
                "allow_execution_tools": false,
                "output_contract": "moonsuite.engineering-projection.v1"
              }
            }
          }
        ]
      },
      "moonsuite-progress-worker": {
        "family": "moonsuite_progress_worker",
        "priority": 20,
        "tags": ["moonsuite", "engineering", "progress", "worker"],
        "steps": [{
          "id": "audit_progress",
          "title": "Audit lifecycle progress",
          "kind": "job.analysis",
          "prompt_template": "Use the MoonSuite progress audit skill for ${request}.",
          "metadata": {
            "preferred_skills": ["moonsuite-progress-audit"], "enable_tools": true,
            "role_runtime": {"planning_layer": "execution", "runtime_mode": "executor", "tool_access": "full", "memory_scope": "workspace", "allow_delegate": false, "allow_workspace_write": false, "allow_execution_tools": true, "output_contract": "moonsuite.project-progress-evidence.v1"}
          }
        }]
      },
      "moonsuite-health-worker": {
        "family": "moonsuite_health_worker",
        "priority": 20,
        "tags": ["moonsuite", "engineering", "health", "worker"],
        "steps": [{
          "id": "audit_health",
          "title": "Run engineering health checks",
          "kind": "job.analysis",
          "prompt_template": "Use the MoonSuite health audit skill for ${request}.",
          "metadata": {
            "preferred_skills": ["moonsuite-health-audit"], "enable_tools": true,
            "role_runtime": {"planning_layer": "execution", "runtime_mode": "executor", "tool_access": "full", "memory_scope": "workspace", "allow_delegate": false, "allow_workspace_write": false, "allow_execution_tools": true, "output_contract": "moonsuite.project-health-evidence.v1"}
          }
        }]
      },
      "moonsuite-production-worker": {
        "family": "moonsuite_production_worker",
        "priority": 20,
        "tags": ["moonsuite", "engineering", "production", "worker"],
        "steps": [{
          "id": "audit_production",
          "title": "Evaluate production Gates",
          "kind": "job.analysis",
          "prompt_template": "Use the MoonSuite production Gate skill for ${request}.",
          "metadata": {
            "preferred_skills": ["moonsuite-production-gate"], "enable_tools": true,
            "role_runtime": {"planning_layer": "execution", "runtime_mode": "executor", "tool_access": "full", "memory_scope": "workspace", "allow_delegate": false, "allow_workspace_write": false, "allow_execution_tools": true, "output_contract": "moonsuite.production-gate-evidence.v1"}
          }
        }]
      },
      "moonsuite-evidence-reviewer": {
        "family": "moonsuite_evidence_reviewer",
        "priority": 20,
        "tags": ["moonsuite", "engineering", "review", "worker"],
        "steps": [{
          "id": "review_evidence",
          "title": "Review audit evidence",
          "kind": "job.analysis",
          "prompt_template": "Use the MoonSuite evidence review skill for ${request}. You must be a different Agent identity from every evidence producer.",
          "metadata": {
            "preferred_skills": ["moonsuite-evidence-review"], "enable_tools": true,
            "role_runtime": {"planning_layer": "execution", "runtime_mode": "executor", "tool_access": "full", "memory_scope": "workspace", "allow_delegate": false, "allow_workspace_write": false, "allow_execution_tools": true, "output_contract": "moonsuite.evidence-review.v1"}
          }
        }]
      }
    }
  }
}
