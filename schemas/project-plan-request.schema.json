{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moonproj/project-plan-request@1.0.0",
  "title": "MoonProj governed project plan request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "operation_ref",
    "plan_request_id",
    "project",
    "prepared_by",
    "prepared_at",
    "owners",
    "budget_envelope",
    "tasks",
    "milestones",
    "risks",
    "acceptance_gates",
    "source_evidence"
  ],
  "properties": {
    "contract_id": {
      "const": "moonproj.project-plan-request.v1"
    },
    "operation_ref": {
      "const": "moonproj/project.plan.prepare@0.1.0"
    },
    "plan_request_id": {
      "$ref": "#/$defs/identifier"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "prepared_by": {
      "$ref": "#/$defs/identifier"
    },
    "prepared_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/owner"
      }
    },
    "budget_envelope": {
      "$ref": "#/$defs/budgetEnvelope"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/milestone"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "acceptance_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/acceptanceGate"
      }
    },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceEvidence"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "nonBlank": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "artifactRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "principal_id",
        "code",
        "name"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/identifier"
        },
        "principal_id": {
          "$ref": "#/$defs/identifier"
        },
        "code": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/nonBlank"
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_id",
        "display_name",
        "role"
      ],
      "properties": {
        "owner_id": {
          "$ref": "#/$defs/identifier"
        },
        "display_name": {
          "$ref": "#/$defs/nonBlank"
        },
        "role": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "budgetEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "limit_minor",
        "contingency_minor"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "limit_minor": {
          "type": "integer",
          "minimum": 0
        },
        "contingency_minor": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "name",
        "owner_id",
        "milestone_id",
        "planned_cost_minor",
        "dependencies",
        "acceptance_gate_ids",
        "source_evidence_refs"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/nonBlank"
        },
        "owner_id": {
          "$ref": "#/$defs/identifier"
        },
        "milestone_id": {
          "$ref": "#/$defs/identifier"
        },
        "planned_cost_minor": {
          "type": "integer",
          "minimum": 0
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "acceptance_gate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "source_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "milestone_id",
        "name",
        "owner_id",
        "target_date",
        "task_ids",
        "acceptance_gate_ids"
      ],
      "properties": {
        "milestone_id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/nonBlank"
        },
        "owner_id": {
          "$ref": "#/$defs/identifier"
        },
        "target_date": {
          "type": "string",
          "format": "date"
        },
        "task_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "acceptance_gate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_id",
        "summary",
        "severity",
        "owner_id",
        "mitigation",
        "related_task_ids",
        "source_evidence_refs"
      ],
      "properties": {
        "risk_id": {
          "$ref": "#/$defs/identifier"
        },
        "summary": {
          "$ref": "#/$defs/nonBlank"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "owner_id": {
          "$ref": "#/$defs/identifier"
        },
        "mitigation": {
          "$ref": "#/$defs/nonBlank"
        },
        "related_task_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "source_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        }
      }
    },
    "acceptanceGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "name",
        "owner_id",
        "scope_type",
        "scope_id",
        "criteria",
        "required_evidence"
      ],
      "properties": {
        "gate_id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/nonBlank"
        },
        "owner_id": {
          "$ref": "#/$defs/identifier"
        },
        "scope_type": {
          "enum": [
            "project",
            "task",
            "milestone"
          ]
        },
        "scope_id": {
          "$ref": "#/$defs/identifier"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonBlank"
          }
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonBlank"
          }
        }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_ref",
        "digest",
        "observed_at",
        "kind"
      ],
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/artifactRef"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "observed_at": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "kind": {
          "$ref": "#/$defs/identifier"
        }
      }
    }
  }
}
